# LANGSMITH_API_KEY=""
# LANGSMITH_TRACING_V2="true"
# LANGSMITH_PROJECT="default"

TAVILY_API_KEY=""
ELASTICSEARCH_URL=""
ELASTICSEARCH_USER=""
ELASTICSEARCH_PASSWORD=""
ELASTICSEARCH_API_KEY=""
MONGODB_URI=""
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME=""
COHERE_API_KEY=""
OPENAI_API_KEY=""
OPENAI_API_BASE=""
LANGSMITH_API_KEY=""

# 附件上传服务（端口与前端代理一致）
UPLOAD_PORT="2025"
# 设置后上传服务要求 Authorization: Bearer <token>
# UPLOAD_TOKEN=""

# 对象存储：Cloudflare R2（S3 兼容）。未配置时退化为本地磁盘
# （apps/agents/.data/uploads）。图片写入 images/，其它附件写入 files/。
R2_ACCOUNT_ID=""
# 可选：完整 endpoint；留空时由 R2_ACCOUNT_ID 拼接
# R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET="ai-upload-files"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# 可选：为 bucket 绑定公开域名后填写，图片 URL 才会长期有效；
# 未配置时使用预签名 URL（默认 7 天）
# R2_PUBLIC_BASE_URL="https://img.example.com"
# 可选：预签名 URL 有效期（秒），默认 604800（7 天）
# UPLOAD_URL_EXPIRES="604800"

# 兼容通用 S3/OSS/MinIO（R2_* 未配置时生效）
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"