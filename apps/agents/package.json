{
  "name": "agents",
  "author": "Your Name",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:kill >/dev/null 2>&1 || true; langgraphjs dev --port 2024 --config ../../langgraph.json",
    "dev:kill": "pkill -9 -f 'langgraph[j]s dev' || true; pkill -9 -f 'langgraph-api/dist/cli/entr[y]point' || true; pkill -9 -f 'node_modules/.bin/langgraph[j]s' || true; lsof -ti tcp:2024 | xargs kill -9 2>/dev/null || true",
    "build": "turbo build:internal --filter=agents",
    "build:internal": "pnpm run clean && tsc",
    "clean": "rm -rf ./dist .turbo || true",
    "format": "prettier --config .prettierrc --write \"src\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.1",
    "@langchain/anthropic": "^1.6.1",
    "@langchain/cohere": "^1.1.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/mongodb": "^1.3.1",
    "@langchain/openai": "^1.8.2",
    "@langchain/pinecone": "^1.0.3",
    "@langchain/tavily": "^1.2.0",
    "@pinecone-database/pinecone": "^5.1.1",
    "dotenv": "^16.4.5",
    "langchain": "^1.6.3",
    "mongodb": "^6.14.2",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@jest/globals": "^29.7.0",
    "@langchain/langgraph-cli": "1.7.0",
    "@types/node": "^20",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "latest",
    "typescript": "^5"
  }
}